{
    "name": "Change Password",
    "method": "POST",
    "url": "{{baseUrl}}/{{base_path}}/profile/change-password",
    "headers": [
        {
            "name": "DeviceID",
            "value": "{{device_id}}",
            "required": false
        },
        {
            "name": "AppID",
            "value": "{{app_id}}",
            "required": false
        },
        {
            "name": "Content-Type",
            "value": "application/json",
            "required": false
        },
        {
            "name": "Authorization",
            "value": "Bearer {{access_token}}",
            "required": false
        }
    ],
    "request": {
        "oldPassword": "newPassword123!",
        "newPassword": "NewPass123!",
        "confirmPassword": "NewPass123!"
    },
    "responses": [
        {
            "code": 200,
            "description": "OK",
            "schema": {
                "statusCode": 200,
                "message": "Password berhasil diubah",
                "error": null,
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "schema": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "oldPassword": "Password lama Anda tidak sesuai"
                },
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "schema": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "newPassword": "Password harus berjumlah minimal 8 karakter, menggunakan kombinasi huruf besar, huruf kecil, angka dan karakter spesial"
                },
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "schema": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "confirmPassword": "Password baru tidak sesuai"
                },
                "value": null
            }
        }
    ]
}
