{
    "name": "list-items",
    "description": "List items; the response body is an array of item objects.",
    "method": "GET",
    "url": "https://api.example.com/items",
    "query": [
        {
            "name": "page",
            "value": "",
            "description": "Page number"
        }
    ],
    "headers": [
        {
            "name": "Authorization",
            "value": "Bearer {token}"
        }
    ],
    "responses": [
        {
            "code": 200,
            "description": "A page of items",
            "example": [
                {
                    "id": "itm_1",
                    "name": "Widget",
                    "tags": [
                        "new"
                    ]
                },
                {
                    "id": "itm_2",
                    "name": "Gadget",
                    "tags": []
                }
            ]
        }
    ]
}
