{
    "name": "bulk-create-items",
    "description": "Create several items in one request; the body is an array of items and the response is an array of created records.",
    "method": "POST",
    "url": "https://api.example.com/items/bulk",
    "headers": [
        {
            "name": "Content-Type",
            "value": "application/json"
        },
        {
            "name": "Authorization",
            "value": "Bearer {token}"
        }
    ],
    "request": {
        "example": [
            {
                "name": "Widget",
                "category": "hardware",
                "tags": [
                    "new",
                    "featured"
                ]
            },
            {
                "name": "Gadget",
                "category": "electronics",
                "tags": []
            }
        ]
    },
    "responses": [
        {
            "code": 201,
            "description": "Items created",
            "example": [
                {
                    "id": "itm_1",
                    "name": "Widget",
                    "category": "hardware",
                    "tags": [
                        "new",
                        "featured"
                    ]
                },
                {
                    "id": "itm_2",
                    "name": "Gadget",
                    "category": "electronics",
                    "tags": []
                }
            ]
        },
        {
            "code": 400,
            "description": "Validation failed"
        }
    ]
}
