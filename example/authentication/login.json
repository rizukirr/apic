{
    "name": "Login",
    "method": "POST",
    "url": "{{baseUrl}}/{{base_path}}/auth/login",
    "headers": [
        {
            "name": "DeviceID",
            "value": "{{device_id}}",
            "required": false
        },
        {
            "name": "AppID",
            "value": "{{app_id}}",
            "required": false
        },
        {
            "name": "Content-Type",
            "value": "application/json",
            "required": false
        }
    ],
    "request": {
        "agentCode": "79009901",
        "password": "newPassword123!"
    },
    "responses": [
        {
            "code": 200,
            "description": "OK",
            "schema": {
                "statusCode": 200,
                "message": "Login berhasil",
                "error": null,
                "value": {
                    "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "tokenType": "Bearer",
                    "isFirstLogin": false
                }
            }
        },
        {
            "code": 200,
            "description": "OK",
            "schema": {
                "statusCode": 200,
                "message": "OTP telah dikirim ke email Anda",
                "error": null,
                "value": {
                    "sessionId": "sess_1234567890abcdef",
                    "isFirstLogin": true,
                    "emailMasked": "leo****ak@sales.bcalife.co.id"
                }
            }
        },
        {
            "code": 401,
            "description": "Unauthorized",
            "schema": {
                "statusCode": 401,
                "message": "Data yang Anda masukkan tidak sesuai. Silakan periksa kembali dan coba lagi.",
                "error": null,
                "value": null
            }
        },
        {
            "code": 429,
            "description": "Too Many Requests",
            "schema": {
                "statusCode": 429,
                "message": "Anda sudah melakukan kesalahan password sebanyak 5x. Coba lagi dalam ",
                "error": null,
                "value": {
                    "coolingDownIn": 300,
                    "unit": "seconds"
                }
            }
        },
        {
            "code": 403,
            "description": "Forbidden",
            "schema": {
                "statusCode": 403,
                "message": "Akun Anda tidak aktif. Silakan hubungi Admin",
                "error": null,
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "schema": {
                "statusCode": 400,
                "message": "Data yang Anda masukkan tidak sesuai. Silakan periksa kembali dan coba lagi.",
                "error": null,
                "value": null
            }
        }
    ]
}
