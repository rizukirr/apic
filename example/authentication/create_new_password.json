{
    "name": "Create New Password",
    "method": "POST",
    "url": "{{baseUrl}}/{{base_path}}/auth/create-password",
    "headers": [
        {
            "name": "DeviceID",
            "value": "{{device_id}}",
            "required": false
        },
        {
            "name": "AppID",
            "value": "{{app_id}}",
            "required": false
        },
        {
            "name": "Content-Type",
            "value": "application/json",
            "required": false
        }
    ],
    "request": {
        "example": {
            "sessionId": "sess_password_reset_xyz",
            "newPassword": "newPassword123!",
            "confirmPassword": "newPassword123!"
        }
    },
    "responses": [
        {
            "code": 200,
            "description": "OK",
            "example": {
                "statusCode": 200,
                "message": "Password berhasil diubah",
                "error": null,
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "example": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "newPassword": "Password harus berjumlah minimal 8 karakter, menggunakan kombinasi huruf besar, huruf kecil, angka dan karakter spesial."
                },
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "example": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "confirmPassword": "Password tidak sama"
                },
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "example": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "newPassword": "Password baru tidak boleh sama dengan password sebelumnya."
                },
                "value": null
            }
        }
    ]
}