{
    "name": "Forgot Password",
    "method": "POST",
    "url": "{{baseUrl}}/{{base_path}}/auth/forgot-password",
    "headers": [
        {
            "name": "DeviceID",
            "value": "{{device_id}}",
            "required": false
        },
        {
            "name": "AppID",
            "value": "{{app_id}}",
            "required": false
        },
        {
            "name": "Content-Type",
            "value": "application/json",
            "required": false
        }
    ],
    "request": {
        "agentCode": "79009901"
    },
    "responses": [
        {
            "code": 200,
            "description": "OK",
            "schema": {
                "statusCode": 200,
                "message": "OTP telah dikirim ke email Anda",
                "error": null,
                "value": {
                    "sessionId": "sess_forgot_1234567890",
                    "emailMasked": "leo****ak@example.co.id"
                }
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "schema": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "agentCode": "Data yang Anda masukkan tidak sesuai. Silakan periksa kembali dan coba lagi."
                },
                "value": null
            }
        },
        {
            "code": 400,
            "description": "Bad Request",
            "schema": {
                "statusCode": 400,
                "message": null,
                "error": {
                    "agentCode": "Data yang Anda masukkan tidak sesuai. Silakan periksa kembali dan coba lagi."
                },
                "value": null
            }
        }
    ]
}
