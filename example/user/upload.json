{
    "name": "upload-avatar",
    "description": "Upload a user avatar",
    "method": "POST",
    "url": "https://api.example.com/user/avatar",
    "headers": [
        {
            "name": "Content-Type",
            "value": "multipart/form-data"
        },
        {
            "name": "Authorization",
            "value": "Bearer {token}"
        }
    ],
    "request": {
        "example": {
            "avatar": "<file: avatar.png>",
            "caption": "My new avatar"
        }
    },
    "responses": [
        {
            "code": 200,
            "description": "Avatar updated"
        }
    ]
}
