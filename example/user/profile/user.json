{
    "name": "user-profile",
    "description": "Public profile of a user",
    "method": "GET",
    "url": "https://api.example.com/user/{id}/profile",
    "headers": [
        {
            "name": "Content-Type",
            "value": "application/json"
        }
    ],
    "responses": [
        {
            "code": 200,
            "description": "success",
            "example": {
                "status": 200,
                "message": "OK",
                "data": {
                    "id": 1,
                    "display_name": "rizukirr",
                    "bio": "Building git-able API contracts",
                    "avatar_url": "https://example.com/avatar/1.png"
                }
            }
        },
        {
            "code": 404,
            "description": "User not found",
            "example": {
                "status": 404,
                "message": "User not found",
                "data": null
            }
        }
    ]
}
