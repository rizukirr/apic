{
    "name": "user",
    "description": "User management",
    "method": "GET",
    "url": "https://api.example.com/user/{id}",
    "headers": [
        {
            "name": "Content-Type",
            "value": "application/json"
        },
        {
            "name": "Authorization",
            "value": "Bearer {token}"
        }
    ],
    "responses": [
        {
            "code": 200,
            "description": "success",
            "example": {
                "status": 200,
                "message": "OK",
                "data": {
                    "id": 1,
                    "name": "Rizki Rakasiwi",
                    "email": "rizki@example.com",
                    "role": "admin"
                }
            }
        },
        {
            "code": 401,
            "description": "Invalid credentials",
            "example": {
                "status": 401,
                "message": "Invalid credentials",
                "data": null
            }
        }
    ]
}
